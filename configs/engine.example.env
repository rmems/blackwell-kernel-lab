# Copy to configs/engine.local.env (gitignored) or export in shell.
# Primary path: Ollama OpenAI-compatible API on this host.

BKL_ENGINE=ollama
BKL_BASE_URL=http://127.0.0.1:11434/v1
BKL_MODEL=granite4.1:8b
# Leave empty for local Ollama
BKL_API_KEY=

# Agent-friendly context (keep multi-turn under 16GB)
BKL_MAX_TOKENS=64
BKL_TEMPERATURE=0
